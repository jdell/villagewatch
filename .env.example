# ---------------------------------------------------------------------------
# VillageWatch environment
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# credentials. Vercel reads these from the project's Environment Variables.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# POOLED connection — pgBouncer, port 6543. Used by the app at runtime via the
# @prisma/adapter-pg driver adapter in src/lib/prisma.ts.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT connection — port 5432. Used by the Prisma CLI only (migrate, db pull,
# studio). Migrations cannot run through a pooler.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Optional. Hosted Supabase usually cannot create a shadow database on the fly;
# point this at a scratch database if `prisma migrate dev` complains.
# SHADOW_DATABASE_URL=""

# --- Supabase Auth / Storage ------------------------------------------------
# Safe to expose — these are inlined into the client bundle.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# SERVER ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_,
# never import into a Client Component, never log.
SUPABASE_SERVICE_ROLE_KEY=""

# Show "Continue with Google" on the sign-in and registration screens. Not a
# credential — the Google client id and secret live in the Supabase dashboard
# under Authentication → Providers. This only says whether to offer the button,
# because a button cannot detect whether its provider is switched on: with
# Google disabled the round trip still happens and fails on the way back.
# Set to "true" only once the provider is enabled AND the callback URL
# <NEXT_PUBLIC_APP_URL>/api/auth/callback is on Supabase's redirect allow list.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# Supabase Storage bucket holding incident photos and video. Create it as a
# PRIVATE bucket — only blurred media is ever written to it, but it is still
# village-scoped resident data.
SUPABASE_STORAGE_BUCKET="incident-media"

# --- On-device face blurring ------------------------------------------------
# Both optional. The MediaPipe WASM runtime (~11MB) and the BlazeFace model
# (~2MB) are static assets fetched by the browser; no user media is sent
# anywhere. Defaults point at the public CDN copies.
#
# To keep every request first-party, copy
# node_modules/@mediapipe/tasks-vision/wasm into public/mediapipe/wasm, put the
# .tflite alongside it, and set these to the local paths.
# NEXT_PUBLIC_MEDIAPIPE_WASM_PATH="/mediapipe/wasm"
# NEXT_PUBLIC_FACE_MODEL_URL="/mediapipe/blaze_face_short_range.tflite"

# --- Application ------------------------------------------------------------
# Canonical origin. Every absolute link the service builds comes from this: the
# deep link in a push notification, the link in an email, and the "View details"
# line in the WhatsApp alert a coordinator pastes into a public channel.
#
# The production domain is the default because those three are all read
# somewhere other than the machine that rendered them. Left unset, the code
# falls back to APP_ORIGIN in src/lib/constants.ts, which is this same value.
#
# RUNNING LOCALLY: change it in your own .env.local, or every link you generate
# points at production.
#
#   NEXT_PUBLIC_APP_URL="http://localhost:3000"
#
NEXT_PUBLIC_APP_URL="https://villagewatch.app"

# --- Version label ----------------------------------------------------------
# Optional. What the app shows in the sidebar, on /settings and in the public
# footer. Leave it unset: next.config.ts fills it from package.json at build
# time, which is the number standard-version and the git tag agree on.
#
# Set it only for a deployment that needs to label itself something else — a
# commit SHA on a preview, a staging marker. It is inlined at BUILD time, so a
# change needs a redeploy to show up.
#
#   NEXT_PUBLIC_APP_VERSION="0.1.24"

# --- Platform administrators ------------------------------------------------
# SERVER ONLY. Comma-separated email addresses, matched case-insensitively
# against the address on the signed-in account.
#
# This is the whole definition of "platform administrator". These people, and
# only these people, can open /admin/coordinators and approve a resident's
# application to become a village coordinator — which is what gives somebody the
# ability to read the original, un-anonymised wording of every report their
# village files. Treat it as a credential and change it in Vercel, not in code.
#
# It is an environment variable rather than the ADMIN user role because of the
# bootstrap: nothing in the application ever sets that role, so the first
# administrator would otherwise be an UPDATE typed into a SQL console.
# UserRole.ADMIN still exists for the RLS policies and no longer opens /admin.
#
# LEAVE IT BLANK AND NOBODY IS AN ADMINISTRATOR. The gate fails closed — an
# empty allow-list admits no one rather than everyone. Coordinator applications
# will still be accepted and will sit unreviewed, which the server logs a
# warning about each time.
ADMIN_EMAILS=""

# A second, narrower list, for the operations that cannot be undone. Today that
# is one screen: /admin/villages/merge, which moves every resident and report
# out of one village into another and archives it. The audit trail it leaves
# behind cannot be moved back and the archived village's join code is not
# recorded anywhere, so the set of people who should hold this is smaller than
# the set who should review coordinator applications.
#
# Checked IN ADDITION to ADMIN_EMAILS, not instead of it — an address here that
# is not also in ADMIN_EMAILS opens nothing.
#
# LEAVE IT BLANK AND NOBODY CAN MERGE A VILLAGE. There is deliberately no
# default: BACKLOG B5 records a real address shipping in this file and granting
# platform admin to every clone of the repository.
SUPER_ADMIN_EMAILS=""

# --- Staff alerts (Slack) ---------------------------------------------------
# Optional. SERVER ONLY — anyone holding this URL can post to the channel.
#
# An incoming webhook (Slack → your app → Incoming Webhooks → Add New Webhook).
# Leave it blank and every alert is written to the server console instead, which
# is a supported state and what local development uses.
#
# This is a STAFF channel, not a product surface. Residents never see it. What
# goes into it is a privacy disclosure — /privacy §6 names it — so read the
# comment at the top of src/lib/slack.ts before adding a call site. Never the
# reporter's original wording, never coordinates.
SLACK_WEBHOOK_URL=""

# --- Error tracking (Sentry) -------------------------------------------------
# Optional, and the whole block is unset on a fresh clone on purpose: with no
# DSN the SDK is inert, nothing is sent, the build still passes and the suite
# still runs with no environment at all. That is the same supported state
# OneSignal, Resend and Slack have.
#
# Sentry is a SUB-PROCESSOR. Adding it was a change to /privacy §6, to the
# sub-processor list in docs/DATA_PROCESSING_AGREEMENT.md and
# docs/COMMUNITY_DPA.md, and to the processor table in docs/DPIA.md §5 — in the
# same commit. Changing what it receives means changing those four again.
#
# It holds full exception messages and stack traces, which is the point of it
# and is also the risk: a message can quote whatever the code put in it. What
# never travels is argued for in src/lib/sentry-scrub.ts — cookies (a live
# Supabase session), request bodies, query strings and user context.
#
# THE ACCOUNT IS IN THE EU (Frankfurt), not the UK. That is a transfer this
# project has to be able to describe: see /privacy §6 and the "Sentry" entry in
# CLAUDE.md. Every value below comes from the Sentry project — there is nothing
# in this repository that can derive them.

# The public DSN. Not a secret: it is compiled into the browser bundle by
# design, and it can only be used to *send* events to this project.
#
# NEXT_PUBLIC_ is inlined AT BUILD TIME, so setting it in Vercel without
# redeploying looks exactly like setting it. That trap cost this project a
# month on OneSignal — see B3 in BACKLOG.md.
NEXT_PUBLIC_SENTRY_DSN=""

# The same DSN for the server and edge runtimes. Set either this or the public
# one; the server prefers this and falls back, so a deployment that sets only
# NEXT_PUBLIC_SENTRY_DSN still reports from both sides.
SENTRY_DSN=""

# Build-time only, for uploading source maps. SERVER ONLY and genuinely secret:
# an org-scoped token can read and write projects. Never prefix it with
# NEXT_PUBLIC_. Create it under Settings → Auth Tokens with `project:releases`.
#
# Unset, the build still succeeds and skips the upload — so a fresh clone and a
# fork both go green. What you lose is readable stack traces: every frame in
# Sentry points at minified output. That failure is quiet and lives in the build
# log, so check it after the first deploy rather than assuming.
SENTRY_AUTH_TOKEN=""

# The org and project slugs, both from the Sentry project's URL:
# https://<org>.sentry.io/projects/<project>/
SENTRY_ORG=""
SENTRY_PROJECT=""

# THE ONE THAT IS EASY TO MISS ON AN EU ACCOUNT. The source map upload
# authenticates against https://sentry.io/ by default, which is the US
# instance — so on an EU account it fails while the application itself reports
# perfectly well, because the DSN carries its own region. The result is a
# working deployment whose stack traces are all minified.
#
# EU: https://de.sentry.io/    US: leave blank
SENTRY_URL="https://de.sentry.io/"

# Performance tracing. Off unless set: a transaction name carries the route, and
# sampling costs quota. 0.1 samples one request in ten if it is ever wanted.
SENTRY_TRACES_SAMPLE_RATE=""

# --- Email (Resend) ---------------------------------------------------------
# Optional. SERVER ONLY — this key can send mail as your verified domain, which
# is a phishing primitive. Never prefix it with NEXT_PUBLIC_.
#
# Leave it blank and the app still works: every message src/lib/email/ renders
# is written to the server console instead of being sent, which is the same
# supported state OneSignal and Slack have and is what local development uses.
# A resident's registration never fails because an email did.
#
# What this sends: the emails VillageWatch itself renders — today the welcome
# that goes out when somebody joins a village, on both the password and the
# Google path.
#
# What this does NOT send: the auth emails. Confirmation, magic link, email
# change and password recovery are minted and sent by Supabase Auth, because
# only Supabase can mint their tokens, and they go out over whatever mailer that
# project is configured with. Pointing Supabase at Resend is a setting in the
# Supabase dashboard rather than a variable here — see
# docs/SUPABASE_EMAIL_SETUP.md, which also covers the branded templates in
# src/lib/email/supabase-templates/. The two uses share a Resend account and
# nothing else.
#
# resend.com -> API Keys -> create one with Sending access. It is shown once.
RESEND_API_KEY=""

# Who the mail comes from, in the format Resend wants: "Name <address@domain>".
# The domain has to be verified in Resend (Domains -> add -> SPF, DKIM and the
# return-path record) or every send is refused.
#
# Blank falls back to "VillageWatch <noreply@villagewatch.app>" — the canonical
# host, for the reason every other absolute URL falls back to it: this is read
# on a machine that is not the one that rendered it.
RESEND_FROM_EMAIL=""

# --- AI (anonymisation, tagging, pattern detection) -------------------------
# SERVER ONLY. Leave the key blank and the app still works: reports are filed
# in the reporter's own wording, the wizard says so on screen, and they wait in
# PENDING_REVIEW for a coordinator exactly as they would otherwise.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Push notifications (OneSignal) -----------------------------------------
# Both optional. With them blank the app still works: the audience is still
# resolved, Notification rows are still written, and the payload is logged to
# the server console instead of being sent.
#
# The app id is inlined into the client bundle — it is public by design and is
# what the browser SDK initialises with. The REST key is SERVER ONLY: it can
# push to every subscriber of the app. Never prefix it with NEXT_PUBLIC_.
#
# Residents are targeted by OneSignal "external id", which we set to the
# Supabase auth user id at sign-in. No segments are used, so no audience
# decisions live in the OneSignal dashboard.
#
# The two app id variables are the SAME value. The browser SDK can only read a
# NEXT_PUBLIC_ one and the server must never read a client-inlined key, so it is
# configured twice. Setting only the public one used to disable server push
# silently; the server now falls back to it and warns. Setting them to DIFFERENT
# app ids is the genuinely broken state — devices subscribe to one and the
# server pushes to the other — and is warned about on boot.
#
# NEXT_PUBLIC_ONESIGNAL_APP_ID is inlined at BUILD time. Setting it in Vercel
# needs a redeploy; setting it in .env.local needs the dev server restarted.
#
# Every failure mode here is silent. See "8. OneSignal" in SETUP.md for the
# checklist and the console breadcrumbs (`[push:client]` and `[push:*]`) that
# say which one you have hit.
NEXT_PUBLIC_ONESIGNAL_APP_ID=""
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""

# --- WhatsApp Channel -------------------------------------------------------
# NOTHING TO CONFIGURE. There is no variable here, and that is the design.
#
# Meta's WhatsApp Cloud API sends messages to phone numbers. It has NO endpoint
# that posts to a Channel — Channels are meant to be posted to by a human, from
# the app. Third-party relays (Whapi and similar) do offer it by driving the
# WhatsApp Web protocol; that can breach WhatsApp's terms and get the number
# behind it banned. WHATSAPP_CHANNEL_API_URL and WHATSAPP_CHANNEL_API_TOKEN used
# to name such a relay. Nothing ever pointed them at one, so they have been
# removed rather than left as a half-built integration; if you have them set,
# they are now ignored and can be deleted from your environment.
#
# What replaced them: approving a report shows the coordinator the alert with a
# "Copy to WhatsApp" button, on /dashboard and on the report's own page. They
# paste it into the channel themselves. See src/lib/format-alert.ts.
#
# Which channel a village uses is that village's own setting and never the
# deployment's — one instance serves many villages, each running its own. A
# coordinator pastes their invite link on /dashboard; the channel code is read
# out of that link rather than typed. Both are stored on that village's row, and
# every resident of that village then gets a "Follow on WhatsApp" link on
# /settings. That needs no API and no credentials.

# --- Content-Security-Policy ------------------------------------------------
# Whether the policy in src/lib/csp.ts is REPORTED or ENFORCED.
#
# Unset (or anything but "true"), the browser blocks what the policy refuses —
# which is the point of having one, and the default. Set to "true" and the same
# policy is sent as Content-Security-Policy-Report-Only: every violation is
# logged to the browser console and nothing is blocked.
#
# The audit that asked for this (VW-02, docs/SECURITY_AUDIT_2026-08-29.md)
# recommends a fortnight of report-only on the deployment before enforcing, and
# it is worth taking. The origins in that module were read out of the source and
# the public pages were checked against a real browser, but what a CSP catches is
# the request nobody knew the app made — and three of this app's riskiest
# surfaces cannot be exercised without a signed-in resident of a live village:
# the Leaflet map's tiles, the MediaPipe WASM face blur, and whatever the
# OneSignal SDK loads after its own bootstrap.
#
# The nonce is applied to Next's own scripts either way, so a report-only run
# exercises the real policy rather than a lookalike. Nothing else in the app
# reads this.
#
# CSP_REPORT_ONLY="true"

# --- Jobs -------------------------------------------------------------------
# Shared secret required by BOTH scheduled routes, which are wired up in
# vercel.json:
#
#   /api/digest          Sunday 09:00 UTC — the weekly digest
#   /api/cron/retention  Daily 02:00 UTC  — archives old reports, deletes old media
#
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`. Leave it blank
# and both routes refuse every request. That is the only safe default: the first
# spends Anthropic credit and pushes to coordinators' phones, and the second
# deletes files and takes reports off the map.
#
# Generate one with: openssl rand -base64 32
CRON_SECRET=""

# --- Seeding ----------------------------------------------------------------
# Used by `npm run db:seed` only. Optional, and only meaningful locally.
#
# SEED_ADMIN_USER_ID must be the id of a REAL user in Supabase Auth
# (Authentication → Users → the row's UID). `User.id` mirrors `auth.users.id`,
# so a profile seeded with any other uuid belongs to nobody and cannot sign in.
# SEED_ADMIN_USER_ID=""
# SEED_ADMIN_EMAIL="coordinator@example.uk"
# SEED_VILLAGE_NAME="Little Mowbray"
