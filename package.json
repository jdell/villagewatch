{
  "name": "villagewatch",
  "version": "0.1.46",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:clean-seed": "npx tsx scripts/clean-seed-data.ts",
    "db:clean-village": "npx tsx scripts/clean-village.ts",
    "db:seed:villages": "npx tsx prisma/seed-villages.ts --county Cambridgeshire",
    "db:seed:villages:all": "npx tsx prisma/seed-villages.ts --all",
    "download:ons": "npx tsx scripts/download-ons-places.ts",
    "generate:supabase-templates": "npx tsx scripts/generate-supabase-templates.ts",
    "db:studio": "prisma studio",
    "release": "standard-version",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "postinstall": "prisma generate"
  },
  "standard-version": {
    "header": "# Changelog\n\nEvery release of VillageWatch. Generated from Conventional Commits by\n`standard-version` — see CONTRIBUTING in the README for the commit format.\n",
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Fixes"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "refactor",
        "section": "Refactoring"
      },
      {
        "type": "docs",
        "section": "Documentation"
      },
      {
        "type": "build",
        "section": "Build and dependencies"
      },
      {
        "type": "ci",
        "section": "CI"
      },
      {
        "type": "revert",
        "section": "Reverts"
      },
      {
        "type": "chore",
        "hidden": true
      },
      {
        "type": "style",
        "hidden": true
      },
      {
        "type": "test",
        "hidden": true
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@hookform/resolvers": "^5.4.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@onesignal/node-onesignal": "^5.12.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "prisma": "^7.9.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.22.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geodesy": "^2.2.8",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "geodesy": "^2.4.0",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
