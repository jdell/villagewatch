// VillageWatch — community safety reporting platform
//
// Prisma 7. The connection URL lives in `prisma.config.ts`, NOT here.
// The runtime connects via the `@prisma/adapter-pg` driver adapter
// (see `src/lib/prisma.ts`).
//
// Spatial columns use PostGIS `geography(Point, 4326)` and are declared as
// `Unsupported(...)` — Prisma Client cannot read or write them directly.
// They are maintained from `lat`/`lng` by a database trigger (see the PostGIS
// migration) and queried with `$queryRaw` for radius / clustering lookups.
// Always treat `lat`/`lng` as the writable source of truth.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// No `extensions` list, and no `postgresqlExtensions` preview feature, on
// purpose. Supabase ships every project with pg_stat_statements, pgcrypto,
// uuid-ossp and supabase_vault already installed. With extension tracking on,
// the migrate engine diffs those four against our migration history, reports
// them as drift, and demands a full reset of the `public` schema on every
// `migrate dev` — which is a data-loss trap once real reports exist.
//
// PostGIS is enabled by `prisma/sql/postgis.sql` instead, which has to run
// after the first migration anyway for the triggers and GiST indexes.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum IncidentType {
  THEFT
  BURGLARY
  VANDALISM
  ASSAULT
  ANTISOCIAL_BEHAVIOUR
  SUSPICIOUS_ACTIVITY
  TRESPASSING
  VEHICLE_CRIME
  DRUG_ACTIVITY
  FRAUD_SCAM
  FIRE
  FLOOD
  ROAD_HAZARD
  WILDLIFE
  MISSING_PERSON
  MISSING_PET
  OTHER

  @@map("incident_type")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("severity")
}

enum IncidentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RESOLVED
  REJECTED
  ARCHIVED
  /// Erased at the reporter's request (UK GDPR Article 17). The row survives
  /// because the audit trail references it (domain rule 7) and because a
  /// coordinator's decisions on it are a record of something that happened; the
  /// media, the tags and every public surface do not. Never in
  /// `PUBLIC_INCIDENT_STATUSES`, and deliberately not reachable by moderation —
  /// only the reporter puts a report here. See `src/lib/erasure.ts`.
  REMOVED

  @@map("incident_status")
}

enum ReportSource {
  WEB
  MOBILE
  WHATSAPP
  SMS
  PHONE
  IMPORTED

  @@map("report_source")
}

enum UserRole {
  RESIDENT
  VERIFIED_RESIDENT
  COORDINATOR
  MODERATOR
  ADMIN

  @@map("user_role")
}

enum VillageStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("village_status")
}

/// Where a resident's application for coordinator access has got to. Note there
/// is no WITHDRAWN value: an applicant who changes their mind simply does not
/// get approved, and adding a state only they can set would be a second way for
/// a row to leave the queue with nothing recorded about who decided what.
enum CoordinatorRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("coordinator_request_status")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A village / neighbourhood watch area. The tenant boundary — every user,
/// incident and pattern alert belongs to exactly one village.
model Village {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  description String?
  status      VillageStatus @default(PENDING)

  // Default map viewport.
  centerLat    Float @map("center_lat")
  centerLng    Float @map("center_lng")
  defaultZoom  Int   @default(14) @map("default_zoom")
  radiusMeters Int   @default(5000) @map("radius_meters")

  /// Optional catchment boundary. Maintained via raw SQL, not Prisma Client.
  boundary Unsupported("geography(Polygon, 4326)")?

  region     String?
  postcode   String?
  country    String  @default("GB") @db.Char(2)
  timezone   String  @default("Europe/London")
  population Int?

  /// The letters in the middle of this village's incident references —
  /// `VW-HIS-2026-0003`. Null derives it from the first three letters of
  /// `name`, which is what every village runs on; see
  /// `src/lib/incident-reference.ts`.
  ///
  /// It exists because the derivation is not unique — every "Great …" parish
  /// derives `GRE` — and two villages sharing a code is a reference a police
  /// officer covering both cannot tell apart. It is not a database problem
  /// (references are unique per village, not per deployment, and the composite
  /// key on `incidents` is what enforces that), so nothing breaks without it;
  /// it is the hand-set answer for the day somebody notices. There is no UI:
  /// set it in Prisma Studio and only for a village that has a clash worth
  /// fixing, because **changing it changes nothing already issued** — the
  /// references on reports already filed are stored strings and they stay as
  /// they are, by design.
  villageCode String? @map("village_code")

  /// Short code residents enter at registration to join this village.
  ///
  /// Minted by `activateVillage()` in `src/lib/village.ts` and **required at
  /// registration whenever it is set** — a village with a code does not accept
  /// a resident who cannot produce it. Null is what a seeded directory entry
  /// looks like before anybody activates it, and the two auth routes refuse
  /// those on `status` before they ever reach this column.
  ///
  /// A credential in everything but name: it is deliberately absent from the
  /// `villages` SELECT grant in `prisma/sql/rls_policies.sql`, so it is not
  /// readable through PostgREST with the anon key.
  joinCode String? @unique @map("join_code")

  /// The parish or town council that is the data controller for this village.
  ///
  /// `DATA_CONTROLLER` in `src/lib/constants.ts` names one controller for the
  /// whole deployment, which was true while a deployment served one parish and
  /// stops being true the moment the directory is activated village by village.
  /// The data controller named in the footer of everything `/reports` produces.
  /// Set by the village's own coordinator on `/dashboard`, or by a platform
  /// administrator on `/admin/villages/[id]`. Null falls back to
  /// `DATA_CONTROLLER` in `constants.ts`; wiring it into `/privacy` is the
  /// follow-up, and until then the constant is still what that page shows.
  parishCouncil String? @map("parish_council")

  /// Which compliance model this village runs under: `community` or `council`.
  ///
  /// **The two differ in who the data controller is**, and everything else
  /// follows from that.
  ///
  /// - `community` (the default) — a neighbourhood group with no parish council
  ///   behind it. Its **coordinator** is the controller and accepts one
  ///   document, `docs/COMMUNITY_DPA.md`, which carries the Article 28(3)
  ///   processing terms and the Schedule 1 paragraph 5 policy document in one
  ///   agreement written for a volunteer.
  /// - `council` — a parish or town council is the controller, and accepts the
  ///   three documents it is separately obliged to hold: the DPIA (Article 35),
  ///   the Appropriate Policy Document (Schedule 1 paragraph 5) and the
  ///   processing agreement (Article 28(3)).
  ///
  /// A `String` and not an enum, and there is no CHECK constraint — the same
  /// shape as `privacyLevel` and for the same reasons. `villageModeFormSchema`
  /// in `src/lib/validations.ts` is the only thing in the application that
  /// writes it, and `resolveVillageMode` in `src/lib/constants.ts` narrows
  /// anything unrecognised back to `community` on the way out rather than
  /// throwing in front of a resident filing a report.
  ///
  /// Upgrading community → council is a coordinator's decision on
  /// `/dashboard/compliance`. There is deliberately no downgrade: it would mean
  /// discarding a council's adopted documents from a settings screen.
  mode String @default("community")

  /// The coordinator's acceptance of the community agreement, in `community`
  /// mode. The council's three are below.
  ///
  /// It is one signature and not half of one, which is the difference from
  /// `dpaAcceptedAt`. The community agreement is offered by Yakasista Ltd on
  /// standing terms and accepting it is what forms the contract — there is no
  /// paper copy waiting on a second signature, because there is no council
  /// clerk to send one to.
  ///
  /// It survives an upgrade to `council` mode and is deliberately never
  /// cleared: the coordinator *was* the controller for that period, and it is
  /// also what keeps a village's reporting open while its council works through
  /// the three documents. See `src/lib/compliance.ts`.
  communityDpaAcceptedAt   DateTime? @map("community_dpa_accepted_at")
  communityDpaAcceptedById String?   @map("community_dpa_accepted_by_id") @db.Uuid
  communityDpaAcceptedBy   User?     @relation("VillageCommunityDpaAcceptor", fields: [communityDpaAcceptedById], references: [id], onDelete: SetNull)

  // --- Legal compliance gate ------------------------------------------------
  // A village cannot accept a single report until its coordinator has read and
  // accepted all three documents. The DPIA is Article 35, the APD is DPA 2018
  // Schedule 1 paragraph 5, and the DPA is Article 28(3). None of the three is
  // paperwork: without an APD the processing of criminal offence data has no
  // lawful authorisation at all, and without a processing agreement the council
  // is in breach from the first report filed — not because anything went wrong
  // with the data, but because the arrangement was never written down.
  //
  // Three pairs rather than one flag, because they are three documents with
  // three different legal instruments behind them and an acceptance is a
  // personal act. `[dpia|apd|dpa]AcceptedById` records who, `…At` records when,
  // and both are what a regulator asks for. `ON DELETE SET NULL` matches every
  // other person-reference on this schema: a coordinator closing their account
  // must not un-accept their village's documents, and the audit trail holds the
  // denormalised email regardless.
  //
  // `dpa` and `dpia` differ by one letter and mean different things — the
  // agreement with the processor, and the impact assessment. Read the column
  // twice before changing anything here.

  dpiaAcceptedAt   DateTime? @map("dpia_accepted_at")
  dpiaAcceptedById String?   @map("dpia_accepted_by_id") @db.Uuid
  dpiaAcceptedBy   User?     @relation("VillageDpiaAcceptor", fields: [dpiaAcceptedById], references: [id], onDelete: SetNull)

  apdAcceptedAt   DateTime? @map("apd_accepted_at")
  apdAcceptedById String?   @map("apd_accepted_by_id") @db.Uuid
  apdAcceptedBy   User?     @relation("VillageApdAcceptor", fields: [apdAcceptedById], references: [id], onDelete: SetNull)

  /// The Article 28(3) data processing agreement with Yakasista Ltd. Unlike the
  /// other two this is a *contract*, so the village row records only the
  /// council's half of it — the processor signs the paper document.
  dpaAcceptedAt   DateTime? @map("dpa_accepted_at")
  dpaAcceptedById String?   @map("dpa_accepted_by_id") @db.Uuid
  dpaAcceptedBy   User?     @relation("VillageDpaAcceptor", fields: [dpaAcceptedById], references: [id], onDelete: SetNull)

  /// Minimum severity that triggers a broadcast push to every resident.
  alertThreshold Severity @default(HIGH) @map("alert_threshold")

  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  /// Publish reports the moment they are filed, with no coordinator review.
  /// **Off by default**, and the default is the safe one: with this on there is
  /// no human between a resident's submission and the village map, so a report
  /// the AI pass never touched — no key, a timeout, a reporter who declined the
  /// rewrite — goes public in the reporter's own words. Domain rule 6 still
  /// holds either way; this changes which status a report is filed in, never
  /// which statuses residents can see.
  autoApprove Boolean @default(false) @map("auto_approve")

  /// How faces in this village's uploaded media are covered.
  ///
  /// One of `PRIVACY_LEVEL_VALUES` in `src/lib/constants.ts` — `light`,
  /// `standard`, `heavy` or `redact` — which is what maps a level to a
  /// redaction mode and a blur radius. `standard` is the default and the
  /// fallback for anything unrecognised, so a value written by hand into psql
  /// can never turn the redaction off.
  ///
  /// `String` rather than an enum on purpose: the levels are a presentation
  /// scale a coordinator picks from, not a domain concept anything branches on,
  /// and adding a fifth would otherwise cost an `ALTER TYPE` in a hand-written
  /// migration. Every read goes through `resolvePrivacyLevel`, which is where
  /// the narrowing happens.
  ///
  /// It never weakens the mosaic. A `blur` at any radius is still resampled to
  /// `MOSAIC_CELLS` first (see `src/lib/media/face-blur.ts`) — the radius is the
  /// Gaussian laid over that, so the level changes how the redaction *looks*
  /// and not whether a face survives it.
  privacyLevel String @default("standard") @map("privacy_level")

  // --- WhatsApp Channel -----------------------------------------------------
  // A channel is a PUBLIC surface: anyone holding the invite link can follow it,
  // village resident or not. That makes it the only place VillageWatch discloses
  // outside the tenant boundary, so all four of these default to "off" or
  // "cautious" and a coordinator has to opt in deliberately.

  /// Public invite link residents follow, e.g.
  /// `https://whatsapp.com/channel/0029Va...`. Shown on /settings. Safe to
  /// render — it is already public by construction.
  whatsappChannelUrl String? @map("whatsapp_channel_url")

  /// The channel identifier the relay posts to. Never rendered to residents;
  /// it is a write credential in everything but name.
  whatsappChannelId String? @map("whatsapp_channel_id")

  /// Mirror published alerts to the channel. **Off by default.** Enabling it
  /// widens the audience for every post from "signed-in residents of this
  /// village" to "the open internet".
  whatsappEnabled Boolean @default(false) @map("whatsapp_enabled")

  /// Floor for what gets mirrored. Higher than the push default on purpose —
  /// a missing cat does not belong on a public feed, a burglary might.
  whatsappMinSeverity Severity @default(HIGH) @map("whatsapp_min_severity")

  users               User[]
  incidents           Incident[]
  patternAlerts       PatternAlert[]
  auditLogs           AuditLog[]
  coordinatorRequests CoordinatorRequest[]

  /// Official recorded-crime figures fetched from data.police.uk for this
  /// village's map centre. Open data about a place, not data about a person —
  /// see the models at the foot of this file.
  policeCrimes        PoliceCrime[]
  policeSyncs         PoliceDataSync[]
  policeNeighbourhood PoliceNeighbourhood?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([country, region])
  @@map("villages")
}

/// Application profile for a Supabase auth user.
/// `id` mirrors `auth.users.id` — it is never generated by Prisma.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  phone     String?
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(RESIDENT)

  villageId String?  @map("village_id") @db.Uuid
  village   Village? @relation(fields: [villageId], references: [id], onDelete: SetNull)

  addressLine String? @map("address_line")

  /// Approximate home location, used to rank nearby incidents. Never exposed
  /// to other residents at full precision.
  homeLat Float? @map("home_lat")
  homeLng Float? @map("home_lng")

  /// Set when a coordinator confirms the resident really lives in the village.
  verifiedAt   DateTime? @map("verified_at")
  verifiedById String?   @map("verified_by_id") @db.Uuid

  // Notification preferences.
  notifyPush         Boolean  @default(true) @map("notify_push")
  notifyEmail        Boolean  @default(true) @map("notify_email")
  notifySms          Boolean  @default(false) @map("notify_sms")
  notifyMinSeverity  Severity @default(LOW) @map("notify_min_severity")
  /// Only alert about incidents within this many metres of `homeLat`/`homeLng`.
  /// Null means village-wide, which is also what applies when a resident has
  /// not told us where they live — there is nothing to measure from.
  notifyRadiusMeters Int?     @map("notify_radius_meters")
  /// Web Push subscription payload (endpoint + keys).
  pushSubscription   Json?    @map("push_subscription")

  onboardedAt  DateTime? @map("onboarded_at")
  lastActiveAt DateTime? @map("last_active_at")

  /// Set when the resident closes their own account (UK GDPR Article 17).
  ///
  /// The row stays. `AuditLog.actorId` points at it, `Incident.reporterId`
  /// points at it, and both are the record of who did what — deleting the row
  /// would sever a trail that is meant to be append-only (domain rule 7).
  /// What closure actually does is in `src/lib/erasure.ts`: every report the
  /// resident filed goes to `REMOVED`, their media is deleted from storage, and
  /// this timestamp is what stops the account being used again.
  ///
  /// The Supabase `auth.users` row is deliberately **not** deleted here. That is
  /// an admin API call with no undo, and the sign-in gates below are what make
  /// this column mean something in the meantime.
  deletedAt DateTime? @map("deleted_at")

  reportedIncidents  Incident[]     @relation("IncidentReporter")
  moderatedIncidents Incident[]     @relation("IncidentModerator")
  acknowledgedAlerts PatternAlert[] @relation("PatternAlertAcknowledger")

  /// Villages whose compliance documents this person accepted. Almost always
  /// zero or one — a coordinator belongs to one village — but the relation is
  /// a list because nothing in the schema enforces that.
  dpiaAcceptedVillages         Village[]      @relation("VillageDpiaAcceptor")
  apdAcceptedVillages          Village[]      @relation("VillageApdAcceptor")
  dpaAcceptedVillages          Village[]      @relation("VillageDpaAcceptor")
  /// And the community agreement, in a village running `community` mode — where
  /// this person is the data controller rather than accepting on a council's
  /// behalf.
  communityDpaAcceptedVillages Village[]      @relation("VillageCommunityDpaAcceptor")
  notifications                Notification[]
  auditLogs                    AuditLog[]

  coordinatorRequests         CoordinatorRequest[] @relation("CoordinatorRequestApplicant")
  reviewedCoordinatorRequests CoordinatorRequest[] @relation("CoordinatorRequestReviewer")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([villageId, role])
  @@map("users")
}

/// A single reported event. `rawDescription` holds the reporter's original
/// words and is never served publicly — `description` is the AI-anonymised
/// version residents actually see.
model Incident {
  id String @id @default(uuid()) @db.Uuid

  /// Human-facing reference, e.g. "VW-HIS-2026-0003" — the village's code, the
  /// year, and this village's third report of that year.
  ///
  /// **Not `@unique`, and that is the change rather than an oversight.** It used
  /// to be a platform-wide sequence (`VW-2026-0184`), which meant a village's
  /// own reports were numbered by how busy every other village had been. The
  /// number is per village per year now, and the uniqueness that matters moved
  /// to the composite key at the foot of this model. A global unique index here
  /// would additionally require village codes to be unique, which the
  /// first-three-letters derivation cannot promise — and the failure mode of
  /// promising it would be a village unable to file a report at all, because
  /// every number it tried was spoken for by a village with the same three
  /// letters.
  ///
  /// The string is stored rather than derived on read because it is what is
  /// already in the audit trail, on a police summary and in a resident's inbox.
  /// It is built in exactly one place — `formatIncidentReference` in
  /// `src/lib/incident-reference.ts` — from the two columns below.
  reference String

  /// The year the reference is numbered within, and the year the sequence
  /// resets on. Taken from `reportedAt` in the deployment's clock (UTC on
  /// Vercel), not from `occurredAt`: a report filed on 2 January about
  /// something that happened on 31 December belongs to this year's sequence,
  /// because the sequence is a filing order rather than a calendar of events.
  referenceYear Int? @map("reference_year")

  /// This village's own count for `referenceYear` — 1 for its first report of
  /// the year, whatever the rest of the deployment has been doing.
  ///
  /// Nullable because every row written before the per-village scheme existed
  /// has no number and never will have a meaningful one; those rows keep the
  /// old-format string in `reference` and are the reason the pair below can
  /// hold NULLs. Allocated by `nextVillageReference()` in
  /// `src/app/api/incidents/route.ts`.
  villageIncidentNumber Int? @map("village_incident_number")

  villageId String  @map("village_id") @db.Uuid
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// Null once the reporter deletes their account — the incident survives.
  reporterId String? @map("reporter_id") @db.Uuid
  reporter   User?   @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  type     IncidentType
  severity Severity       @default(MEDIUM)
  status   IncidentStatus @default(PENDING_REVIEW)
  source   ReportSource   @default(WEB)

  title String

  /// Verbatim submission. May contain names, plates, addresses. Restricted to
  /// the reporter, coordinators and moderators.
  ///
  /// **Nullable because it is deleted.** `/api/cron/retention` clears it in the
  /// same statement that archives the report at
  /// `RETENTION.incidentArchiveMonths`, which is what the privacy notice has
  /// always said happens; null is that deletion, and it is deliberately not a
  /// placeholder string — a sentinel is a value a reporter could have typed,
  /// and this column is the one place a resident's unedited words live. Erasure
  /// is the other direction and does use a placeholder (`ERASED_TEXT` in
  /// `src/lib/erasure.ts`), because a tombstone has something to say to whoever
  /// opens the report and an archived report does not.
  ///
  /// Read through `readRawDescription()` in `src/lib/moderation.ts` and nowhere
  /// else (domain rule 1). That is the one caller that has to handle the null.
  rawDescription String? @map("raw_description")

  /// Public, AI-anonymised description — this is what the map and list render.
  description String

  // AI processing metadata.
  aiSummary     String?   @map("ai_summary")
  aiModel       String?   @map("ai_model")
  aiProcessedAt DateTime? @map("ai_processed_at")
  aiConfidence  Float?    @map("ai_confidence")
  anonymized    Boolean   @default(false)

  /// People involved, as a count only — never identities.
  peopleCount Int? @map("people_count")

  /// Set when this report matches others nearby in the last 30 days.
  recurring   Boolean @default(false)
  /// The match in one line, e.g. "4th report of vehicle crime within 200m
  /// in the last 30 days". Public — it is derived from published incidents only.
  patternNote String? @map("pattern_note")

  /// Hide the reporter's identity from other residents.
  isAnonymous Boolean @default(false) @map("is_anonymous")

  occurredAt DateTime  @map("occurred_at")
  reportedAt DateTime  @default(now()) @map("reported_at")
  resolvedAt DateTime? @map("resolved_at")

  /// Free-text landmark, e.g. "the lane behind the village hall".
  locationText String? @map("location_text")

  /// Public coordinates, already jittered by `locationFuzzMeters`. The exact
  /// reported point is never persisted.
  lat Float?
  lng Float?

  /// PostGIS point derived from lat/lng by trigger. Read via `$queryRaw`.
  locationPoint Unsupported("geography(Point, 4326)")? @map("location_point")

  /// Radius in metres the coordinates were jittered by, for privacy.
  locationFuzzMeters Int @default(100) @map("location_fuzz_meters")

  reportedToPolice Boolean @default(false) @map("reported_to_police")
  policeReference  String? @map("police_reference")

  viewCount    Int @default(0) @map("view_count")
  confirmCount Int @default(0) @map("confirm_count")

  moderatedById  String?   @map("moderated_by_id") @db.Uuid
  moderatedBy    User?     @relation("IncidentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt    DateTime? @map("moderated_at")
  moderationNote String?   @map("moderation_note")

  media         IncidentMedia[]
  tags          IncidentTag[]
  notifications Notification[]
  patternAlerts PatternAlert[]  @relation("PatternAlertIncidents")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// What actually stops two reports filed in the same second from sharing a
  /// number. The application reads `MAX(villageIncidentNumber) + 1`, which two
  /// concurrent requests can both read; this is the constraint that turns the
  /// loser into a P2002 the create loop retries, rather than two reports with
  /// the same reference on a police summary.
  ///
  /// Rows from before the scheme carry NULL in both columns, and Postgres
  /// treats NULLs as distinct in a unique index — so they neither collide with
  /// each other nor need a backfill to be tolerated. They were backfilled
  /// anyway, in `20260803120000_incident_village_numbering`.
  @@unique([villageId, referenceYear, villageIncidentNumber], map: "incidents_village_year_number_key")
  @@index([villageId, status, occurredAt(sort: Desc)])
  @@index([villageId, type])
  @@index([villageId, severity])
  @@index([reporterId])
  @@index([lat, lng])
  @@map("incidents")
}

/// Photo, video or audio attached to an incident. Files live in Supabase
/// Storage; only the path is stored here.
model IncidentMedia {
  id String @id @default(uuid()) @db.Uuid

  incidentId String   @map("incident_id") @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  storagePath String  @map("storage_path")
  publicUrl   String? @map("public_url")
  mimeType    String  @map("mime_type")
  fileSize    Int     @map("file_size")

  width           Int?
  height          Int?
  durationSeconds Int? @map("duration_seconds")

  caption String?

  /// Redacted copy with faces and number plates blurred. This is the variant
  /// served publicly once `redactedAt` is set.
  redactedPath String?   @map("redacted_path")
  redactedAt   DateTime? @map("redacted_at")
  /// Objects / labels returned by the vision model.
  aiLabels     Json?     @map("ai_labels")

  /// EXIF (including GPS) must be stripped before anything is served.
  exifStripped Boolean @default(false) @map("exif_stripped")

  position Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([incidentId, position])
  @@map("incident_media")
}

/// Free-form label on an incident. Mostly AI-generated ("white van",
/// "back gardens") — this is what pattern detection clusters on.
model IncidentTag {
  id String @id @default(uuid()) @db.Uuid

  incidentId String   @map("incident_id") @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  label      String
  /// "ai" | "user" | "system"
  source     String @default("ai")
  confidence Float?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([incidentId, label])
  @@index([label])
  @@map("incident_tags")
}

/// One delivery of one message to one user on one channel.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  incidentId String?   @map("incident_id") @db.Uuid
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  patternAlertId String?       @map("pattern_alert_id") @db.Uuid
  patternAlert   PatternAlert? @relation(fields: [patternAlertId], references: [id], onDelete: Cascade)

  title   String
  body    String
  /// "push" | "email" | "sms" | "in_app"
  channel String  @default("push")
  /// Deep link opened when the notification is tapped.
  url     String?
  data    Json?

  sentAt        DateTime? @map("sent_at")
  deliveredAt   DateTime? @map("delivered_at")
  readAt        DateTime? @map("read_at")
  failedAt      DateTime? @map("failed_at")
  failureReason String?   @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([incidentId])
  @@map("notifications")
}

/// A cluster of related incidents surfaced by pattern detection — e.g. six
/// vehicle break-ins within 400m over four nights.
model PatternAlert {
  id String @id @default(uuid()) @db.Uuid

  villageId String  @map("village_id") @db.Uuid
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  title   String
  summary String

  /// Dominant incident type in the cluster, when there is one.
  type     IncidentType?
  severity Severity      @default(MEDIUM)

  incidentCount Int      @map("incident_count")
  windowStart   DateTime @map("window_start")
  windowEnd     DateTime @map("window_end")

  centroidLat  Float? @map("centroid_lat")
  centroidLng  Float? @map("centroid_lng")
  radiusMeters Int?   @map("radius_meters")

  /// PostGIS centroid derived from centroidLat/Lng by trigger.
  centroidPoint Unsupported("geography(Point, 4326)")? @map("centroid_point")

  /// 0–1 score from the detector. Below the notify threshold the alert is
  /// created but not broadcast.
  confidence Float @default(0)

  detector String @default("dbscan")

  notifiedAt       DateTime? @map("notified_at")
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  acknowledgedBy   User?     @relation("PatternAlertAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  dismissedAt      DateTime? @map("dismissed_at")

  incidents     Incident[]     @relation("PatternAlertIncidents")
  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([villageId, createdAt(sort: Desc)])
  @@index([villageId, acknowledgedAt])
  @@map("pattern_alerts")
}

/// A resident asking to be made a coordinator of their village.
///
/// Coordinator is the role that can read `Incident.rawDescription` and decide
/// what the whole village sees, so it is never self-service: a resident applies
/// here and a platform administrator approves. The promotion itself is written
/// by server code from an approval on this table, never from a client payload
/// (domain rule 5) — see `src/lib/coordinator-requests.ts`.
model CoordinatorRequest {
  id String @id @default(uuid()) @db.Uuid

  /// The applicant. Cascades: a closed account has no live application.
  userId String @map("user_id") @db.Uuid
  user   User   @relation("CoordinatorRequestApplicant", fields: [userId], references: [id], onDelete: Cascade)

  /// The village they are applying to coordinate — always their own, taken
  /// from their profile and never from the submitted form.
  villageId String  @map("village_id") @db.Uuid
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// The standing the applicant claims in the village — "Neighbourhood Watch
  /// coordinator", "Parish councillor" and so on. **Not a `UserRole`**: it is
  /// what they say they are, for the reviewer to weigh, and it grants nothing.
  /// Free text in the column and constrained to `COORDINATOR_APPLICANT_ROLES`
  /// by `src/lib/validations.ts`, so a later addition to that list does not
  /// need a migration.
  role String

  /// Whatever "Something else" meant, or extra context on the role above.
  roleDetail String? @map("role_detail")

  /// Why they want it, in their own words. Shown to the reviewing admin.
  reason String

  status CoordinatorRequestStatus @default(PENDING)

  /// The administrator who decided. Null while pending, and null again if that
  /// account is later deleted — `reviewedAt` still records that it happened.
  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?     @relation("CoordinatorRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @map("reviewed_at")

  /// The reviewer's note. Sent to the applicant on a rejection, so it is
  /// written to be read by them rather than filed about them.
  reviewNote String? @map("review_note")

  createdAt DateTime @default(now()) @map("created_at")

  /// The admin queue: pending first, newest first.
  @@index([status, createdAt(sort: Desc)])
  /// The applicant's own latest application, for the settings screen.
  @@index([userId, createdAt(sort: Desc)])
  @@index([villageId, status])
  @@map("coordinator_requests")
}

/// One fixed rate-limit window for one subject and one action.
///
/// This table exists because the previous limiter kept its counters in a `Map`
/// in the process. On Vercel that is per lambda instance and resets on every
/// cold start, so the stated limits were not limits — a caller who could trigger
/// scale-out got a multiple of them, and an idle deployment handed out a fresh
/// quota to whoever woke it up. Shared state is the fix, and Postgres is already
/// here.
///
/// **Server-only.** `prisma/sql/rls_policies.sql` grants `authenticated` nothing
/// at all on this table: a client that could read it would learn how much quota
/// is left before spending it, and one that could write it could clear its own
/// counter. `src/lib/rate-limit.ts` is the only thing that touches it.
model RateLimit {
  id String @id @default(uuid()) @db.Uuid

  /// The Supabase auth user id — text, and deliberately **not** a foreign key.
  ///
  /// A rate limit is about a caller, not about a resident. Keying it to `users`
  /// would mean a closed account's counters cascaded away, which is a way to
  /// reset a limit by re-registering, and it would make the limiter depend on a
  /// profile row existing at all. Old rows are swept by the retention cron
  /// instead — see `RATE_LIMIT_RETENTION_DAYS`.
  userId String @map("user_id")

  /// `RateLimitRule.name` — "ai-process", "incident-create".
  action String

  /// Start of the fixed window, aligned to a multiple of the rule's window
  /// length so that every caller in the same window computes the same value and
  /// the unique constraint below can carry the upsert.
  windowStart DateTime @map("window_start") @db.Timestamptz(3)

  /// Calls counted in this window. Incremented past the limit rather than
  /// clamped: the comparison is `count <= limit`, and a rejected call still
  /// consumes, so hammering a closed window does not buy a free probe.
  count Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// What makes the counter atomic. `INSERT ... ON CONFLICT (user_id, action,
  /// window_start) DO UPDATE SET count = count + 1` is one statement, so two
  /// concurrent requests cannot both read 4 and both write 5.
  @@unique([userId, action, windowStart])
  /// For the nightly sweep, which deletes by age and by nothing else.
  @@index([windowStart])
  @@map("rate_limit")
}

/// Append-only trail of privileged actions — moderation, role changes, and
/// every read of un-anonymised report text. Never updated or deleted from
/// application code.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId    String? @map("actor_id") @db.Uuid
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised so the trail survives account deletion.
  actorEmail String? @map("actor_email")
  actorRole  String? @map("actor_role")

  villageId String?  @map("village_id") @db.Uuid
  village   Village? @relation(fields: [villageId], references: [id], onDelete: SetNull)

  /// e.g. "incident.publish", "user.role_change", "incident.raw_viewed"
  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  before Json?
  after  Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([villageId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Official police data (data.police.uk)
// ---------------------------------------------------------------------------
//
// Three tables, and none of them holds personal data.
//
// `data.police.uk` publishes recorded crime under the Open Government Licence.
// Every record is snapped to an anonymised map point — the published location is
// a notional point "on or near" a street, chosen so that no crime can be tied to
// an address — and it carries no victim, no suspect and no officer. That is what
// makes it safe to store beside a village's own reports and to print in a
// document. It is also why none of the domain rules about `rawDescription`,
// coordinate fuzzing or the public status list has an analogue here: there is
// nothing in these rows to restrict.
//
// What they *are* scoped by is the village (domain rule 4), and for a reason
// that is about correctness rather than privacy. The figures are fetched for one
// village's map centre over a one-mile radius, so a row is an answer to a
// question asked about that village and means nothing detached from it.

/// One crime as data.police.uk published it, for one village and one month.
///
/// Fetched by `GET|POST /api/cron/police-data` and read by the dashboard and
/// `/reports`. Nothing in the application writes a row any other way, and
/// nothing edits one — a month is replaced wholesale when it is re-fetched,
/// because the upstream figures are revised as investigations close and a
/// half-updated month is worse than a stale one.
model PoliceCrime {
  id String @id @default(uuid()) @db.Uuid

  villageId String  @map("village_id") @db.Uuid
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// The API's own per-record id, kept as text.
  ///
  /// It arrives as a JSON number and is stored as a string on purpose: it is an
  /// opaque token to us — we never sort it, compare it or do arithmetic on it —
  /// and the published values passed 100 million some years ago. A 32-bit
  /// column would be a migration nobody schedules until the day it overflows.
  ///
  /// **Not stable between months.** The API's own `persistent_id` is the stable
  /// one and is very often an empty string, which is why the unique key below
  /// is on this column instead: within one village-month it does identify a
  /// record, which is all the deduplication a wholesale replace needs.
  crimeId String @map("crime_id")

  /// The API's `persistent_id`, where it has one. Frequently empty upstream —
  /// stored when present so that a future feature which needs to follow one
  /// crime across months has somewhere to look, and never relied on here.
  persistentId String? @map("persistent_id")

  /// `YYYY-MM`, exactly as published. Text rather than a date because that is
  /// what it is: a calendar month with no day, no time and no zone attached.
  /// `isPoliceMonth` in `src/lib/constants.ts` is what narrows anything written
  /// into it.
  month String

  /// The API's category slug — `vehicle-crime`, `anti-social-behaviour`.
  /// `policeCategoryLabel` turns it into words; the slug is stored because the
  /// Home Office's own label for a category has changed before and the slug has
  /// not.
  category String

  /// The published point, which is an anonymisation point rather than a
  /// location. Nullable because a record occasionally arrives with none.
  ///
  /// There is deliberately **no PostGIS column beside these**, unlike
  /// `Incident.locationPoint`. Nothing queries this table by radius — the
  /// radius was applied upstream, by the API, when the month was fetched — so a
  /// geography column and its trigger would be maintained for no reader.
  lat Float?
  lng Float?

  streetId   Int?    @map("street_id")
  streetName String? @map("street_name")

  /// "Force" or "BTP" — which body recorded it. British Transport Police
  /// figures cover the railway and are published alongside the local force's.
  locationType    String? @map("location_type")
  locationSubtype String? @map("location_subtype")

  /// The force's own free-text note. Almost always empty; stored because when
  /// it is not, it is the only sentence on the record a person wrote.
  context String?

  /// What happened to it, as at the last fetch — "Under investigation",
  /// "Court result unavailable". Revised upstream after publication, which is
  /// why a stored month is re-fetched at `POLICE_REFRESH_DAYS` rather than kept
  /// forever.
  outcomeCategory String? @map("outcome_category")
  /// `YYYY-MM` again, and the month the outcome was recorded rather than the
  /// month of the crime.
  outcomeDate     String? @map("outcome_date")

  fetchedAt DateTime @default(now()) @map("fetched_at")

  /// What makes a re-fetch idempotent. A month is deleted and re-inserted in one
  /// transaction, so this is a backstop rather than the mechanism — but without
  /// it, two sync runs racing on the same village-month would double every
  /// figure in a document sent to the police, which is the one failure here that
  /// would not look like one.
  @@unique([villageId, month, crimeId], map: "police_crimes_village_month_crime_key")
  @@index([villageId, month])
  @@index([villageId, category])
  @@map("police_crimes")
}

/// What one sync run did to one village-month, and when.
///
/// The bookkeeping that makes the cache a cache. Two things depend on it:
///
///  1. **Skipping work.** A month fetched inside `POLICE_REFRESH_DAYS` is not
///     fetched again, which is what keeps a nightly-ish job from asking the Home
///     Office for the same unchanged month every run.
///  2. **Telling "none" apart from "not yet".** A village-month with no row has
///     never been fetched; a row with `status = "ok"` and `crimeCount = 0` is a
///     month the police published with nothing in it. Printing "0 recorded
///     crimes" for the first of those, in a document addressed to the police,
///     would be a false statement — and it is exactly the shape of false
///     statement that a `count(*)` returning zero produces silently. Every
///     surface that renders these figures names the months it actually holds.
model PoliceDataSync {
  id String @id @default(uuid()) @db.Uuid

  villageId String  @map("village_id") @db.Uuid
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// `YYYY-MM`.
  month String

  /// `ok` — fetched, whatever the count. `empty` — the API had no data for this
  /// month yet, which is the ordinary state of the last two months.
  /// `unavailable` — the area holds more crimes than the API will return.
  /// `failed` — a timeout, a network error or an unreadable body.
  ///
  /// A `String` and not an enum, the same shape as `Village.mode` and
  /// `Village.privacyLevel` and for the same reason: it is an operational note
  /// rather than a domain concept anything branches on, and a fifth value
  /// should not cost an `ALTER TYPE` in a hand-written migration.
  status String

  /// Rows stored for this village-month. Zero is a real answer; see above.
  crimeCount Int @map("crime_count")

  /// Whatever the failure was, in one line, for whoever reads the cron log.
  detail String?

  fetchedAt DateTime @map("fetched_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([villageId, month])
  @@index([villageId, month(sort: Desc)])
  @@map("police_data_syncs")
}

/// The policing neighbourhood a village sits in, and the team that covers it.
///
/// One row per village — this is the answer to "who is our PCSO", which every
/// coordinator needs and which nothing in VillageWatch could tell them before.
/// Resolved from the village's map centre through `locate-neighbourhood` and
/// then filled in from the force's own published team list.
///
/// ## The officers named here are published by the force
///
/// A neighbourhood team page is public, on the force's own website, precisely so
/// that residents can contact the officers on it. What is stored is name, rank
/// and the contact address the force publishes for them — the working details of
/// a public office, which is why this sits comfortably beside open crime data
/// rather than under the rules that govern a resident's row.
///
/// What is deliberately **not** stored is the `bio` the API returns alongside
/// each officer. It is force-authored HTML, and rendering third-party HTML is a
/// stored-XSS surface this codebase does not otherwise have — `MarkdownView`
/// exists so that even the compliance documents need no `dangerouslySetInnerHTML`.
model PoliceNeighbourhood {
  id String @id @default(uuid()) @db.Uuid

  /// One per village, which is what makes the relation on `Village` a `?`
  /// rather than a list.
  villageId String  @unique @map("village_id") @db.Uuid
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  /// The force slug — `cambridgeshire`. Cambridgeshire Constabulary is the
  /// pilot, and the only thing that makes it the pilot is which village was
  /// activated first; nothing in this schema is force-specific.
  forceId   String  @map("force_id")
  forceName String? @map("force_name")

  /// The force's own identifier for the neighbourhood — `NC04`, `CN1`. Unique
  /// within a force and meaningless outside it, which is why the pair is always
  /// carried together.
  neighbourhoodId String @map("neighbourhood_id")

  name        String
  description String?

  /// The force's page for this neighbourhood, for a coordinator who wants the
  /// detail this table deliberately does not hold.
  urlForce String? @map("url_force")

  centreLat Float? @map("centre_lat")
  centreLng Float? @map("centre_lng")

  /// Published contact points for the team. Every one of these is an address a
  /// force prints on a poster.
  email     String?
  telephone String?
  facebook  String?
  twitter   String?

  /// The team, as `[{ name, rank, email }]`, capped at
  /// `POLICE_TEAM_MAX_MEMBERS`. JSON rather than a fourth table because nothing
  /// queries an officer — the whole list is read together, rendered together and
  /// replaced together on every refresh.
  team Json?

  fetchedAt DateTime @map("fetched_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([forceId, neighbourhoodId])
  @@map("police_neighbourhoods")
}
